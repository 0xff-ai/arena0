{
  "name": "@0xff-ai/arena0-client",
  "version": "0.1.0",
  "description": "TypeScript types and HTTP client for the arena0 daemon API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/0xff-ai/arena0#readme",
  "bugs": {
    "url": "https://github.com/0xff-ai/arena0/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xff-ai/arena0",
    "directory": "npm/arena0-client"
  }
}
